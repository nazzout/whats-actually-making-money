# Copy to .env.local for local development. On Vercel, add these in Project Settings > Environment Variables.
# With no Firebase key the app runs in local mode: data lives in .data/local-db.json, seeded from data/seed/companies.json.

# Firebase service account JSON (one line). Firebase console > Project settings > Service accounts > Generate new private key.
FIREBASE_SERVICE_ACCOUNT=

# Password for the owner login at /admin/login. Pick a long random string.
ADMIN_PASSWORD=

# Secret used to sign the owner session cookie. Generate with: openssl rand -hex 32
SESSION_SECRET=

# Key agents send as "Authorization: Bearer <key>" to the agent API and MCP endpoint. Generate with: openssl rand -hex 32
AGENT_API_KEY=

# Vercel sends this to cron routes automatically when set. Generate with: openssl rand -hex 32
CRON_SECRET=

# SEC EDGAR requires a descriptive User-Agent with contact details, e.g. "Making Money Research you@example.com".
SEC_USER_AGENT=

# Optional. Free key from https://developer.company-information.service.gov.uk/ for UK filing checks.
COMPANIES_HOUSE_API_KEY=

# Optional. Free Brandfetch Logo API client ID from https://developers.brandfetch.com/ for company logos.
# It is public by design (it appears in image URLs). Without it, companies show letter tiles.
BRANDFETCH_CLIENT_ID=

# Optional. Anthropic API key from https://console.anthropic.com/ to turn on "ask anything". Leave empty for keyword search.
ANTHROPIC_API_KEY=
# Optional. Model used for "ask anything".
ASK_MODEL=claude-haiku-4-5
